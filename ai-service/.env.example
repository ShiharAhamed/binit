# Application Configuration
APP_NAME="SmartWaste AI Service"
APP_ENV="development"
HOST="127.0.0.1"
PORT=8000

# Authoritative Backend API
ASPNET_API_BASE_URL="http://localhost:5276"
INTERNAL_SERVICE_KEY="change-me"
TOOL_HTTP_TIMEOUT=10.0

# C2 advisory collection starts (match backend Municipality:TimeZoneId)
MUNICIPAL_TIMEZONE="Asia/Colombo"
COLLECTION_WINDOW_START="08:00"
COLLECTION_WINDOW_END="16:00"

# LLM Provider Configuration ('mock' for offline tests, 'google' for Gemini API)
LLM_PROVIDER="mock"
LLM_MODEL="gemini-1.5-flash"
LLM_API_KEY=""
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30.0

