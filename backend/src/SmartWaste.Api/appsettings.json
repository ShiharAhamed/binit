{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Municipality": {
    "TimeZoneId": "Asia/Colombo"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=smartwaste_db;Username=postgres;Password=CHANGE_ME"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SmartWaste.Api",
    "Audience": "SmartWaste.Clients",
    "ExpiryMinutes": 60
  },
  "AiService": {
    "BaseUrl": "http://127.0.0.1:8000",
    "TimeoutSeconds": 300
  },
  "ReportTriggeredWorkflowWorker": {
    "Enabled": true,
    "PollIntervalSeconds": 15,
    "LeaseSeconds": 420,
    "RetryDelaySeconds": 60,
    "MaxAttempts": 3
  },
  "Storage": {
    "Supabase": {
      "BaseUrl": "",
      "SecretKey": "",
      "Bucket": "waste-report-attachments",
      "SignedUrlExpirySeconds": 900
    }
  },
  "InternalService": {
    "ApiKey": ""
  }
}